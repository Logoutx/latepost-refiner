# Copy to .env (or export in your shell). The Universal CLI runs on DeepSeek only.
DEEPSEEK_API_KEY=sk-...           # required — DeepSeek 的 API key，精校全程使用

# 建议：Tavily 是联网核实 / 时间线的默认搜索后端。
TAVILY_API_KEY=...

# 可选实验：未配置 Tavily 时，可改用 Serper 搜索。
SERPER_API_KEY=...

# 可选实验：Jina Reader authentication for webpage extraction. Public Reader works without a key;
# failures fall back to an SSRF-safe local text fetcher.
JINA_API_KEY=...
