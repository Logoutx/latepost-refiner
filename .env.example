# Copy to .env (or export in your shell). The Universal CLI runs on DeepSeek only.
DEEPSEEK_API_KEY=sk-...           # required — DeepSeek 的 API key，精校全程使用

# Recommended: Serper web search for 联网核实 / 时间线. Without it, verify/timeline
# degrade gracefully to no-verify (refine 精校 never goes online, so it's unaffected).
SERPER_API_KEY=...

# Optional: Jina Reader authentication for webpage extraction. Public Reader works without a key;
# failures fall back to an SSRF-safe local text fetcher.
JINA_API_KEY=...
